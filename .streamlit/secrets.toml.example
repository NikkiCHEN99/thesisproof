# Streamlit Secrets 模板
#
# 用途：
#   本地（可选）—— 复制为 .streamlit/secrets.toml 后填写（该文件已被 .gitignore 忽略）
#   线上（必需）—— 部署到 Streamlit Community Cloud 后，在
#                  App settings → Secrets 里粘贴下面的内容（换成真实值）
#
# 说明：
#   Streamlit 会把顶层且值为字符串的 secret 写入 os.environ，
#   项目通过 config.get_secret() 读取，因此键名必须与下面完全一致。

# DeepSeek：命题拆解 / 证据分类 / 结论生成
# 本地也可写在项目根目录的 .env 里
DEEPSEEK_API_KEY = "sk-xxxxxxxxxxxxxxxx"

# iFinD MCP 认证 token
# 取值来源：~/.workbuddy/skills/ifind-finance-data/mcp_config.json 的 "auth_token" 字段
IFIND_MCP_KEY = "eyJxxxxxxxx..."

# 扶摇数据源（当前代码尚未接入，仅占位）
FUYAO_API_KEY = "xxxxxxxx"
